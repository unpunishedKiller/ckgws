<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ShopController" spacing="10" alignment="CENTER">
    <children>
        <TextField fx:id="shopNameField" promptText="Shop Name"/>
        <TextField fx:id="shopLocationField" promptText="Location"/> <!-- Corrected -->
        <Button text="Add Shop" onAction="#addShop"/>
    </children>
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Button text="Go Back" onAction="#goBack"/>

</VBox>

