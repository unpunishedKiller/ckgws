<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.ShopController">
    <TextField fx:id="shopIdField" promptText="Shop ID"/>
    <TextField fx:id="shopNameField" promptText="Shop Name"/>
    <TextField fx:id="shopLocationField" promptText="Location"/>
    <Button text="Update Shop" onAction="#updateShop"/>
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Button text="Go Back" onAction="#goBack"/>

</VBox>

