<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.control.Button?>
<VBox xmlns:fx="http://javafx.com/javafx" fx:controller="controller.WelcomeController" alignment="CENTER" spacing="20">
    <!-- Logo -->
    <ImageView fitWidth="200" preserveRatio="true">
        <image>
            <Image url="@images/WhatsApp Image 2025-02-04 at 13.00.54_af0daaa8.jpg"/>
        </image>
    </ImageView>

    <!-- Welcome Text -->
    <Label text="Welcome to CKGWS Management System" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label text="Select an option from the menu to get started."/>

    <Button text="Shops" onAction="#goToShops"/>
    <Button text="Books" onAction="#goToBooks"/>
    <Button text="Transactions" onAction="#goToTransactions"/>

</VBox>


