<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.BooksController" spacing="10" alignment="CENTER">
    <Label text="Books - Transactions" style="-fx-font-size: 16px;" />
    <TableView fx:id="transactionTable" prefHeight="400" prefWidth="600">
        <columns>
            <TableColumn fx:id="shopIdColumn" text="Shop ID" />
            <TableColumn fx:id="dateColumn" text="Date" />
            <TableColumn fx:id="weightInColumn" text="Weight In" />
            <TableColumn fx:id="weightOutColumn" text="Weight Out" />
        </columns>
    </TableView>
    <Button text="Load Transactions" onAction="#loadTransactions" />

</VBox>
