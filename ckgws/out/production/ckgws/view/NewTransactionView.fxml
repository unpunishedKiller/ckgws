<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.NewTransactionController" spacing="10" alignment="CENTER">
    <Label text="Add New Transaction" />
    <HBox spacing="5">
        <Label text="Shop ID:" />
        <TextField fx:id="shopIdField" />
    </HBox>
    <HBox spacing="5">
        <Label text="Date:" />
        <DatePicker fx:id="dateField" />
    </HBox>
    <HBox spacing="5">
        <Label text="Weight In:" />
        <TextField fx:id="weightInField" />
    </HBox>
    <HBox spacing="5">
        <Label text="Weight Out:" />
        <TextField fx:id="weightOutField" />
    </HBox>
    <Button text="Add Transaction" onAction="#addTransaction" />

</VBox>
